# Basic settings
IMAGE_REGISTRY=docker.io/psncedcmvds
IMAGE_TAG=latest
STORAGE_IMAGE=rustfs/rustfs:1.0.0-alpha.85
POSTGRES_IMAGE=postgres:16
TRAEFIK_IMAGE=traefik:v2.11
VAULT_IMAGE=hashicorp/vault:1.16

# Hosts 
PUBLIC_SCHEME=https
CONNECTOR_HOST=connector.example.com
DASHBOARD_HOST=dashboard.example.com
KEYCLOAK_HOST=keycloak.example.com
TRAEFIK_DASHBOARD_HOST=traefik.example.com
IDENTITY_HUB_HOST=identity-hub.example.com
VAULT_HOST=vault.example.com
CONSUMER_BACKEND_HOST=consumer-backend.example.com
STORAGE_HOST=storage.example.com

LETSENCRYPT_EMAIL=admin@example.com

DEPLOYMENT_MODE=production
OAUTH_CLIENT_ID=data-space-users

# Use comma-separated values, e.g.: keycloak,identity,storage
# Leave empty to run only mandatory services.
COMPOSE_PROFILES=

# DIDs
CONNECTOR_ID=test-connector
PARTICIPANT_ID="did:web:${IDENTITY_HUB_HOST}:${CONNECTOR_ID}"

# Provided by dataspace
ISSUER_DID=<issuer-did>
FEDERATED_CATALOG_ADDRESS=<federated-catalog-url>
DATASPACE_HUB_URL=CHANGE_ME_DATASPACE_HUB_URL
CATALOG_API_KEY=CHANGE_ME_CATALOG_API_KEY

# Addresses
CONSUMER_BACKEND_URL=${PUBLIC_SCHEME}://${CONSUMER_BACKEND_HOST}/edr-endpoint
KEYCLOAK_ADDRESS=${PUBLIC_SCHEME}://${KEYCLOAK_HOST} # if self-hosted, otherwise use keycloak address
IDENTITY_HUB_ADDRESS=${PUBLIC_SCHEME}://${IDENTITY_HUB_HOST} # if self-hosted, otherwise use identity-hub address
VAULT_ADDRESS=${PUBLIC_SCHEME}://${VAULT_HOST}

# Passwords to generate
COMMON_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
CONNECTOR_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
KEYCLOAK_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
IDENTITY_HUB_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
STORAGE_SECRET_KEY=CHANGE_ME_STRONG_PASSWORD
CONNECTOR_STS_CLIENT_SECRET_ALIAS=CHANGE_ME_STRONG_SECRET
# Below values require specific formats or encodings, use the instructions from README to generate them.
# Generate: printf "%s.%s\n" "$(printf '%s' "super-user" | base64 | tr -d '\n')" "$(printf '%s' "secret" | base64 | tr -d '\n')"
IDENTITY_HUB_SUPERUSER_KEY=CHANGE_ME_BASE64_DOT_BASE64
# Generate: htpasswd -nb admin 'admin' | sed -e 's/\$/\$\$/g'
TRAEFIK_BASIC_AUTH=admin:$$apr1$$replace$$replace

CONNECTOR_DB_USER=edc
CONNECTOR_DB_NAME=edc

KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_ADMIN_USER=admin

IDENTITY_HUB_DB_USER=edc
IDENTITY_HUB_DB_NAME=edc

STORAGE_ACCESS_KEY=rustfs-admin
STORAGE_BUCKET=downloads
STORAGE_DEFAULT_PREFIX=edc-transfers
STORAGE_DEFAULT_FOLDER=anonymous

CATALOG_DSP_ID=federated-catalog
CONNECTOR_API_KEY=edc

CONNECTOR_PUBLIC_KEY_ID="${PARTICIPANT_ID}#key-1"
IDENTITY_HUB_STS_PUBLIC_KEY_ID="${PARTICIPANT_ID}#key-1"
IDENTITY_HUB_KEY_URL_PATH=/certs/consumer_public.pem

# Optional envs for python Keycloak bootstrap scripts and dataspace hub integration
# Can be left as it is
DATASPACE_MAX_WAIT_SECONDS=60
DATASPACE_POLL_INTERVAL_SECONDS=3
USER_NAME=test
USER_PASS=edc
FC_GROUP=federated-catalog
CATALOG_CLIENT_SECRET=catalog-secret
CONNECTOR_CLIENT_SECRET=connector-secret
CONNECTOR_ROLE=access-connector
USER_CLIENT_ID=data-space-users
