apiVersion: v1
kind: List
items:
  - apiVersion: route.openshift.io/v1
    kind: Route
    metadata:
      name: "{{ application }}-storage-s3"
      annotations:
        haproxy.router.openshift.io/ip_whitelist: "{{ route_ip_whitelist }}"
      labels:
        app: "{{ application }}"
        component: storage
    spec:
      host: "{{ storage_host }}"
      path: /s3
      to:
        kind: Service
        name: "{{ application }}-storage"
        weight: 100
      port:
        targetPort: s3
      tls:
        termination: edge
        insecureEdgeTerminationPolicy: Redirect
      wildcardPolicy: None

  - apiVersion: route.openshift.io/v1
    kind: Route
    metadata:
      name: "{{ application }}-storage-console"
      annotations:
        haproxy.router.openshift.io/ip_whitelist: "{{ route_ip_whitelist }}"
      labels:
        app: "{{ application }}"
        component: storage
    spec:
      host: "{{ storage_host }}"
      path: /
      to:
        kind: Service
        name: "{{ application }}-storage"
        weight: 100
      port:
        targetPort: console
      tls:
        termination: edge
        insecureEdgeTerminationPolicy: Redirect
      wildcardPolicy: None