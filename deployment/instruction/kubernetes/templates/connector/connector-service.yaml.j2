apiVersion: v1
kind: Service
metadata:
  name: "{{ application }}-connector"
  labels:
    app: "{{ application }}"
    component: connector
spec:
  selector:
    app: "{{ application }}"
    component: connector
  ports:
    - name: api
      port: 8080
      targetPort: api
    - name: management
      port: 8081
      targetPort: management
    - name: protocol
      port: 8082
      targetPort: protocol
    - name: control
      port: 8083
      targetPort: control
    - name: catalog
      port: 8084
      targetPort: catalog
    - name: version
      port: 8085
      targetPort: version
    - name: catalogproxy
      port: 8086
      targetPort: catalogproxy
    - name: public
      port: 11001
      targetPort: public
