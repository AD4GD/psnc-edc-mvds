apiVersion: v1
kind: ConfigMap
metadata:
  name: "{{ application }}-connector"
  labels:
    app: "{{ application }}"
    component: connector
data:
  # Control plane specific config
  EDC_IAM_ISSUER_ID: "{{ participant_id }}"
  WEB_HTTP_PORT: "8080"
  WEB_HTTP_PATH: /api
  WEB_HTTP_MANAGEMENT_PORT: "8081"
  WEB_HTTP_MANAGEMENT_PATH: /api/management
  WEB_HTTP_PROTOCOL_PORT: "8082"
  WEB_HTTP_PROTOCOL_PATH: /api/dsp
  WEB_HTTP_CONTROL_PORT: "8083"
  WEB_HTTP_CONTROL_PATH: /api/control
  WEB_HTTP_CATALOG_PORT: "8084"
  WEB_HTTP_CATALOG_PATH: /api/catalog
  WEB_HTTP_VERSION_PORT: "8085"
  WEB_HTTP_VERSION_PATH: /api/version
  WEB_HTTP_CATALOGPROXY_PORT: "8086"
  WEB_HTTP_CATALOGPROXY_PATH: /api/catalog-proxy
  EDC_IAM_DID_WEB_USE_HTTPS: "{{ 'true' if public_scheme == 'https' else 'false' }}"
  EDC_IAM_STS_PRIVATEKEY_ALIAS: "key-1"
  EDC_IAM_STS_PUBLICKEY_ID: "{{ participant_id }}#key-1"
  EDC_DSP_CALLBACK_ADDRESS: "{{ public_scheme }}://{{ connector_host }}/api/dsp"
  EDC_PARTICIPANT_ID: "{{ participant_id }}"
  EDC_MANAGEMENT_CONTEXT_ENABLED: "true"
  EDC_IAM_STS_OAUTH_CLIENT_ID: "{{ participant_id }}"
  EDC_IAM_STS_OAUTH_TOKEN_URL: "{{ public_scheme }}://{{ identity_hub_host }}/api/sts/token"
  EDC_IAM_STS_OAUTH_CLIENT_SECRET_ALIAS: "{{ sts_client_secret }}"

  # control plane AUTH (tokenbased, delegated, composite, none)
  WEB_HTTP_AUTH_TYPE: "{{ 'composite' if is_auth else 'none' }}"
  WEB_HTTP_AUTH_INCLUDES: '{{ (["tokenbased", "delegated"] if is_auth else []) | to_json }}'
  WEB_HTTP_AUTH_DAC_KEY_URL: "{{ public_scheme }}://{{ keycloak_host }}/realms/Organizations/protocol/openid-connect/certs"

  WEB_HTTP_MANAGEMENT_AUTH_TYPE: "{{ 'composite' if is_auth else 'none' }}"
  WEB_HTTP_MANAGEMENT_AUTH_INCLUDES: '{{ (["tokenbased", "delegated"] if is_auth else []) | to_json }}'
  WEB_HTTP_MANAGEMENT_AUTH_DAC_KEY_URL: "{{ public_scheme }}://{{ keycloak_host }}/realms/Organizations/protocol/openid-connect/certs"
  WEB_HTTP_MANAGEMENT_AUTH_AUDIENCE: "{{ web_http_management_auth_audience if (web_http_management_auth_audience | default('') | length > 0) else connector_id }}"
  WEB_HTTP_MANAGEMENT_AUTH_DAC_AUDIENCE: "{{ web_http_management_auth_audience if (web_http_management_auth_audience | default('') | length > 0) else connector_id }}"

  WEB_HTTP_CONTROL_AUTH_TYPE: "{{ 'tokenbased' if is_auth else 'none' }}"
  
  # Dataplane specific config
  EDC_DATAPLANE_API_PUBLIC_BASEURL: "{{ public_scheme }}://{{ connector_host }}/api/public"
  EDC_TRANSFER_PROXY_TOKEN_VERIFIER_PUBLICKEY_ALIAS: "{{ participant_id }}#key-1"
  EDC_TRANSFER_PROXY_TOKEN_SIGNER_PRIVATEKEY_ALIAS: key-1
  EDC_DPF_SELECTOR_URL: "{{ public_scheme }}://{{ connector_host }}/api/control/v1/dataplanes"
  WEB_HTTP_PUBLIC_PORT: "11001"
  WEB_HTTP_PUBLIC_PATH: /api/public

  # CORS
  EDC_WEB_REST_CORS_ENABLED: "true"
  EDC_WEB_REST_CORS_HEADERS: origin,content-type,accept,authorization,x-api-key

  # Persistence
  EDC_SQL_SCHEMA_AUTOCREATE: "true"
  EDC_VAULT_HASHICORP_URL: "{{ vault_url }}"
  EDC_VAULT_HASHICORP_TOKEN_TTL: "0"
  EDC_VAULT_HASHICORP_TOKEN_SCHEDULED_RENEW_ENABLED: "false"
  JAVA_TOOL_OPTIONS: "-Dedc.vault.hashicorp.token.scheduled-renew-enabled=false"

  # Catalog proxy
  EDC_CATALOG_PROXY_DSP_ENABLED: "false"
  WEB_HTTP_CATALOGPROXY_AUTH_TYPE: "{{ 'composite' if is_auth else 'none' }}"
  WEB_HTTP_CATALOGPROXY_AUTH_INCLUDES: '{{ (["tokenbased", "delegated"] if is_auth else []) | to_json }}'
  WEB_HTTP_CATALOGPROXY_AUTH_CONTEXT: "catalogproxy"
  WEB_HTTP_CATALOGPROXY_AUTH_DAC_KEY_URL: "{{ public_scheme }}://{{ keycloak_host }}/realms/Organizations/protocol/openid-connect/certs"
  WEB_HTTP_CATALOGPROXY_AUTH_AUDIENCE: '{{ (web_http_catalogproxy_auth_audience if (web_http_catalogproxy_auth_audience | default([]) | length > 0) else ["federated-catalog", connector_id]) | to_json }}'
{% if web_http_catalogproxy_auth_roles | default([]) | length > 0 %}
  WEB_HTTP_CATALOGPROXY_AUTH_ROLES: '{{ web_http_catalogproxy_auth_roles | to_json }}'
{% endif %}

  EDC_CATALOG_PROXY_DSP_COUNTERPARTY_ADDRESS: "{{ federated_catalog_address }}/api/catalog"
  EDC_CATALOG_PROXY_DSP_COUNTERPARTY_ID: "federated-catalog"
  EDC_CATALOG_PROXY_DSP_PROTOCOL: "dataspace-protocol-http"
  EDC_CATALOG_PROXY_HTTP_TARGET_URL: "{{ federated_catalog_address }}/api/catalog/v1alpha/catalog/query"
  EDC_CATALOG_PROXY_HTTP_APIKEY_HEADER: "x-api-key"
  EDC_CATALOG_PROXY_HTTP_APIKEY: "{{ catalog_api_key }}"

  # trusted issuers (JSON array of DIDs)
  EDC_TRUSTED_ISSUERS: '{{ ["did:web:data-space-hub-ceads-data-space.apps.bst2.paas.psnc.pl"] | to_json }}'
