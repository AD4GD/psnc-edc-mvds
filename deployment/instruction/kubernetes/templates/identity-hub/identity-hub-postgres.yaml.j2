apiVersion: v1
kind: Service
metadata:
  name: "{{ identity_hub_db_service }}"
  labels:
    app: "{{ application }}"
    component: identity-hub-db
spec:
  clusterIP: None
  selector:
    app: "{{ application }}"
    component: identity-hub-db
  ports:
    - name: postgres
      port: 5432
      targetPort: postgres
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: "{{ identity_hub_db_service }}"
  labels:
    app: "{{ application }}"
    component: identity-hub-db
spec:
  serviceName: "{{ identity_hub_db_service }}"
  replicas: 1
  selector:
    matchLabels:
      app: "{{ application }}"
      component: identity-hub-db
  template:
    metadata:
      labels:
        app: "{{ application }}"
        component: identity-hub-db
    spec:
{% if image_pull_secret_name | default('') | length > 0 %}
      imagePullSecrets:
        - name: "{{ image_pull_secret_name }}"
{% endif %}
      containers:
        - name: postgres
          image: "{{ postgres_image }}"
          ports:
            - name: postgres
              containerPort: 5432
          env:
            - name: POSTGRESQL_USERNAME
              valueFrom:
                secretKeyRef:
                  name: "identity-hub-db-secret"
                  key: POSTGRES_USER
            - name: POSTGRESQL_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: "identity-hub-db-secret"
                  key: POSTGRES_PASSWORD
            - name: POSTGRESQL_DATABASE
              valueFrom:
                secretKeyRef:
                  name: "identity-hub-db-secret"
                  key: POSTGRES_DB
          volumeMounts:
            - name: data
              mountPath: /bitnami/postgresql
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes:
          - ReadWriteOnce
        resources:
          requests:
            storage: "{{ identity_hub_db_storage_size }}"
