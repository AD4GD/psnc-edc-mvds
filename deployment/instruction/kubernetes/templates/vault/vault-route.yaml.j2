{% set vault_name = application ~ '-vault-' ~ identity_hub_vault_instance %}
apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: "{{ vault_name }}"
  annotations:
    haproxy.router.openshift.io/ip_whitelist: "{{ route_ip_whitelist }}"
  labels:
    app: "{{ application }}"
    component: vault
    vault_instance: "{{ identity_hub_vault_instance }}"
spec:
  host: "{{ keyvault_host }}"
  path: /
  to:
    kind: Service
    name: "{{ vault_name }}"
    weight: 100
  port:
    targetPort: vault-http
  tls:
    termination: edge
    insecureEdgeTerminationPolicy: Redirect
  wildcardPolicy: None