apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: "{{ application }}-dashboard"
  annotations:
    haproxy.router.openshift.io/ip_whitelist: "{{ route_ip_whitelist }}"
  labels:
    app: "{{ application }}"
    component: dashboard
spec:
  host: "{{ dashboard_host }}"
  path: /
  to:
    kind: Service
    name: "{{ application }}-dashboard"
    weight: 100
  port:
    targetPort: www
  tls:
    termination: edge
    insecureEdgeTerminationPolicy: Redirect
  wildcardPolicy: None
