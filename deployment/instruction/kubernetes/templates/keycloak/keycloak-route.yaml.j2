apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: "{{ application }}-keycloak"
  annotations:
    haproxy.router.openshift.io/ip_whitelist: "{{ route_ip_whitelist }}"
  labels:
    app: "{{ application }}"
    component: keycloak
spec:
  host: "{{ keycloak_host }}"
  path: /
  to:
    kind: Service
    name: "{{ application }}-keycloak"
    weight: 100
  port:
    targetPort: keycloak-http
  tls:
    termination: edge
    insecureEdgeTerminationPolicy: Redirect
  wildcardPolicy: None