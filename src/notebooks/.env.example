# DCAT source URL
CATALOG_URL=https://example.com/catalog.json

# Connector management API base URL (without trailing /v3)
MANAGEMENT_API=https://provider-connector.example.com/api/management
# Connector DSP endpoint for DataService registration (required)
DSP_API=http://provider-connector:8192/api/dsp

# Management API catalog request settings
# Address of the counter-party DSP (used as counterPartyAddress)
CATALOG_COUNTER_PARTY_ADDRESS=http://provider-connector:8192/api/dsp
# Counter-party participant DID (URL-encoded if needed)
CATALOG_COUNTER_PARTY_ID=did:web:provider-ih%3A7093:bob
# Protocol for catalog request (default shown)
CATALOG_PROTOCOL=dataspace-protocol-http

# Login mode hint: api_key or credentials
# Script always tries API_KEY first when present, then falls back to credentials.
LOGIN_MODE=api_key

# API key auth
API_KEY=edc

# Credential auth fallback (Keycloak password grant)
USERNAME=
PASSWORD=
KEYCLOAK_URL=https://keycloak.example.com/realms/master
# Optional explicit token endpoint. If empty, script uses: {KEYCLOAK_URL}/protocol/openid-connect/token
KEYCLOAK_TOKEN_URL=
KEYCLOAK_CLIENT_ID=admin-cli
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_GRANT_TYPE=password

# Optional settings
POLICY_ID=test-policy
PROXY_ENABLED=true
REQUEST_TIMEOUT_SECONDS=20
SLEEP_SECONDS=0.02

# Optional: custom path to env file
# ENV_FILE=/absolute/path/to/.env
