# DCAT source URL
CATALOG_URL=https://example.com/catalog.json

# Connector management API base URL (without trailing /v3)
MANAGEMENT_API=https://provider-connector.example.com/api/management

# Login mode hint: api_key or credentials
# Script always tries API_KEY first when present, then falls back to credentials.
LOGIN_MODE=api_key

# API key auth
API_KEY=edc

# Credential auth fallback (Keycloak password grant)
USERNAME=
PASSWORD=
KEYCLOAK_URL=https://keycloak.example.com/realms/master
# Optional explicit token endpoint. If empty, script uses: {KEYCLOAK_URL}/protocol/openid-connect/token
KEYCLOAK_TOKEN_URL=
KEYCLOAK_CLIENT_ID=admin-cli
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_GRANT_TYPE=password

# Optional settings
POLICY_ID=test-policy
PROXY_ENABLED=true
REQUEST_TIMEOUT_SECONDS=20
SLEEP_SECONDS=0.02

# Optional: custom path to env file
# ENV_FILE=/absolute/path/to/.env
