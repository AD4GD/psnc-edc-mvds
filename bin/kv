#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export COMPOSE_PROJECT_NAME_SCRIPT=devstack

case "${1:-}" in
	up|start|restart)
		if [[ -z ${DISABLE_KV_AUTO_INIT_UNSEAL:+x} ]]
		then
			"$SCRIPT_DIR/compose" -f base.yaml -f consumer.yaml -f provider.yaml up -d \
				data-space-hub-vault provider-ih-vault consumer-ih-vault fc-ih-vault
			"$SCRIPT_DIR/compose" -f base.yaml -f consumer.yaml -f provider.yaml run --rm --no-deps vault-unseal
		fi
		;;
esac

# exec "$SCRIPT_DIR/compose" -f vault.yaml "$@"
