# For every vault that needs to be initialized/unsealed by compose/base.yaml vault-unseal service, add corresponding token and unseal shard variables here. 
# These are used by scripts/vault-init-unseal.sh to generate vault.env snapshots in bin/secrets/*.env, which are then loaded by vault-unseal service and injected into rendered service config files.
SERVICE_NAME_VAULT_TOKEN=
SERVICE_NAME_VAULT_UNSEAL_SHARD=