#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SECRETS_DIR="$SCRIPT_DIR/secrets"
GENERATED_DIR="$REPO_ROOT/compose/.generated"

load_env_file() {
  local file="$1"
  if [[ -f "$file" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "$file"
    set +a
  fi
}

if [[ -d "$SECRETS_DIR" ]]; then
  shopt -s nullglob
  for env_file in "$SECRETS_DIR"/*.env; do
    load_env_file "$env_file"
  done
  shopt -u nullglob
fi

mkdir -p "$GENERATED_DIR/docker/connector/config"
mkdir -p "$GENERATED_DIR/docker/federated-catalog/config"
mkdir -p "$GENERATED_DIR/docker/identity-hub/config"
mkdir -p "$GENERATED_DIR/docker/data-space-hub/config"

copy_with_replacements() {
  local src="$1"
  local dst="$2"
  shift 2

  cp "$src" "$dst"

  while [[ $# -gt 0 ]]; do
    local key="$1"
    local value="$2"
    shift 2

    if [[ -n "$value" ]]; then
      sed -i.bak -E "s|^(${key})\s*=.*$|\1=${value}|" "$dst"
    fi
  done

  rm -f "${dst}.bak"
}

copy_with_replacements \
  "$REPO_ROOT/docker/connector/config/configuration-provider.properties" \
  "$GENERATED_DIR/docker/connector/config/configuration-provider.properties" \
  "edc.vault.hashicorp.token" "${PROVIDER_VAULT_TOKEN:-}"

copy_with_replacements \
  "$REPO_ROOT/docker/connector/config/configuration-consumer.properties" \
  "$GENERATED_DIR/docker/connector/config/configuration-consumer.properties" \
  "edc.vault.hashicorp.token" "${CONSUMER_VAULT_TOKEN:-}"

copy_with_replacements \
  "$REPO_ROOT/docker/federated-catalog/config/configuration.properties" \
  "$GENERATED_DIR/docker/federated-catalog/config/configuration.properties" \
  "edc.vault.hashicorp.token" "${FC_VAULT_TOKEN:-}"

copy_with_replacements \
  "$REPO_ROOT/docker/identity-hub/config/configuration-provider.properties" \
  "$GENERATED_DIR/docker/identity-hub/config/configuration-provider.properties" \
  "edc.vault.hashicorp.token" "${PROVIDER_VAULT_TOKEN:-}"

copy_with_replacements \
  "$REPO_ROOT/docker/identity-hub/config/configuration-consumer.properties" \
  "$GENERATED_DIR/docker/identity-hub/config/configuration-consumer.properties" \
  "edc.vault.hashicorp.token" "${CONSUMER_VAULT_TOKEN:-}"

copy_with_replacements \
  "$REPO_ROOT/docker/identity-hub/config/configuration-fc.properties" \
  "$GENERATED_DIR/docker/identity-hub/config/configuration-fc.properties" \
  "edc.vault.hashicorp.token" "${FC_VAULT_TOKEN:-}"

copy_with_replacements \
  "$REPO_ROOT/docker/data-space-hub/config/config.properties" \
  "$GENERATED_DIR/docker/data-space-hub/config/config.properties" \
  "VAULT_TOKEN" "${DSH_VAULT_TOKEN:-}"

echo "Rendered generated config files in: $GENERATED_DIR" >&2
