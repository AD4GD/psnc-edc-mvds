# Copy this file to bin/.env.secrets and fill your own values.

# Vault tokens used inside mounted service configuration files
PROVIDER_IH_VAULT_TOKEN="<hvs.token>"
CONSUMER_IH_VAULT_TOKEN="<hvs.token>"
FC_IH_VAULT_TOKEN="<hvs.token>"
PROVIDER_CONNECTOR_VAULT_TOKEN="<hvs.token>"
CONSUMER_CONNECTOR_VAULT_TOKEN="<hvs.token>"
FEDERATED_CATALOG_VAULT_TOKEN="<hvs.token>"
DATA_SPACE_HUB_VAULT_TOKEN="<hvs.token>"

# Vault unseal shards used by compose/base.yaml vault-unseal service
DSH_VAULT_UNSEAL_SHARD="<key>"
PROVIDER_IH_VAULT_UNSEAL_SHARD="<key>"
CONSUMER_IH_VAULT_UNSEAL_SHARD="<key>"
FC_IH_VAULT_UNSEAL_SHARD="<key>"
